#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define LOWER 1
#define ALT_TAB_LAYER 4
#define MOUSE_SLOW 5
#define MOUSE_FAST 6
#define BOT bootloader

/* Layout-independent "`" via WinCompose: Menu (K_APP), then 6, 0.
 * F13 is dropped over BLE, so it typed "60". RAlt is AltGr on Russian.
 * Digits 6/0 are the same on EN and RU. Fence newlines are Shift+Enter.
 *
 * WinCompose (once):
 *   1. Compose key = Application / Menu  (settings.ini: compose_key=VK.APPS)
 *   2. %USERPROFILE%\.XCompose  — this one line only, no include:
 *        <Multi_key> <6> <0> : "`" # backtick
 *      Then restart WinCompose.
 */

#define UC_MACRO_TAP_MS 5
#define UC_MACRO_WAIT_MS 5

/ {
    input_processors {
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };

        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };

        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };

        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };

        ip_y_invert: ip_y_invert {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_Y>;
        };

        ip_x_half: ip_x_half {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X>;
            track-remainders;
        };

        /* Scale &mmv X/Y. Params are multiplier then divisor (max 16). */

        ip_xy_scale: ip_xy_scale {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };

        ip_xy_to_scroll: ip_xy_to_scroll {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            map = <INPUT_REL_Y INPUT_REL_WHEEL>, <INPUT_REL_X INPUT_REL_HWHEEL>;
        };

        /* Drop X/Y/wheel while Left Ctrl is in the HID report (held key or LC()). */

        ip_mute_if_lctrl: ip_mute_if_lctrl {
            compatible = "zmk,input-processor-mute-if-lctrl";
            #input-processor-cells = <0>;
        };
    };
};

/ {
    macros {
        // Replaces "&mo 1" on lower-layer hold keys.

        mod_key: mod_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo LOWER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_release>,
                <&mo ALT_TAB_LAYER>,
                <&macro_release>,
                <&mo LOWER>;
        };

        // First tap: press Alt once, send key, enable ALT_TAB_LAYER.
        // Further taps hit that layer (plain &kp) so Alt refcount stays at 1.
        // ZMK refcounts modifiers — macro_press LALT on every tap was the "giga latch".

        alt_latch: alt_latch {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&mo ALT_TAB_LAYER>;
        };

        // Single tap: "``" with the caret between the backticks.
        // Sequences are fully inlined (not nested `&uc`) so later keys like LEFT
        // are not queued ahead of the unicode HID events.

        bt_pair: backtick_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <UC_MACRO_WAIT_MS>;
            tap-ms = <UC_MACRO_TAP_MS>;
            bindings =
                <&macro_tap>,
                <&kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp LEFT>;
        };

        // Double tap: "```" with the caret after the backticks.

        bt_triple: backtick_triple {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <UC_MACRO_WAIT_MS>;
            tap-ms = <UC_MACRO_TAP_MS>;
            bindings =
                <&macro_tap>,
                <&kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0>;
        };

        // Triple tap: fence with Shift+Enter newlines, caret on the empty middle line.

        bt_fence: code_fence {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <UC_MACRO_WAIT_MS>;
            tap-ms = <UC_MACRO_TAP_MS>;
            bindings =
                <&macro_tap>,
                <&kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp LS(ENTER) &kp LS(ENTER) &kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp K_APP &kp N6 &kp N0 &kp LS(ENTER) &kp UP &kp UP>;
        };
    };
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        // Single tap: "``" pair. Double tap: "```". Triple tap: markdown code fence block.

        td_bt: tap_dance_backtick {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&bt_pair>, <&bt_triple>, <&bt_fence>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        sp_sc: behavior_spacescroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        // Layer-tap where pressing any other key while held immediately
        // triggers the hold (layer), instead of waiting for tapping-term.

        mlt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo &kp>;
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC     &kp N1        &kp N2  &kp N3    &kp N4          &kp N5                &kp C_MUTE       &kp C_MUTE  &kp N6     &kp N7     &kp N8  &kp N9    &kp N0     &kp BACKSPACE
&kp GRAVE   &kp Q         &kp W   &kp E     &kp R           &kp T                 &kp Y            &kp U       &kp I      &kp O      &kp P   &kp BSLH
&mlt 3 TAB  &kp A         &kp S   &kp D     &kp F           &kp G                 &mkp LCLK        &mkp LCLK   &kp H      &kp J      &kp K   &kp L     &kp SEMI   &kp LEFT_GUI
&mod_key    &kp Z         &kp X   &kp C     &kp V           &kp B                 &kp PG_DN        &kp PG_UP   &mkp LCLK  &mkp RCLK  &kp N   &kp M     &kp COMMA  &kp DOT        &kp FSLH  &mod_key
&mo 2       &kp LEFT_ALT  &mo 2   &mod_key  &sk LEFT_SHIFT  &mt LEFT_SHIFT ENTER  &mt LCTRL SPACE  &kp MINUS   &kp EQUAL  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp ESC     &kp F1              &kp F2                  &kp F3          &kp F4                   &kp F5          &bt BT_CLR   &kp C_MUTE          &kp F6              &kp F7      &kp F8           &kp F9      &kp F10   &kp DELETE
&td_bt      &kp ESCAPE          &kp LC(PAGE_UP)         &kp LC(T)       &kp LC(PAGE_DOWN)        &none           &kp PAGE_UP  &kp HOME            &kp UP              &kp END     &kp PRINTSCREEN  &kp F11
&kp TAB     &none               &kp LA(LC(LEFT_ARROW))  &alt_latch TAB  &kp LA(LC(RIGHT_ARROW))  &kp LEFT_SHIFT  &mkp RCLK    &mkp RCLK           &kp PAGE_DOWN       &kp LEFT    &kp DOWN         &kp RIGHT   &kp SQT   &kp F12
&kp LA(F4)  &kp LG(DOWN_ARROW)  &kp LS(LC(PAGE_UP))     &kp LC(W)       &kp LS(LC(PAGE_DOWN))    &none           &trans       &trans              &bl BL_DEC          &bl BL_INC  &trans           &kp INSERT  &kp LBKT  &kp RBKT    &kp UNDER  &trans
&trans      &trans              &trans                  &trans          &trans                   &kp LEFT_SHIFT  &trans       &kp LC(LEFT_SHIFT)  &kp LA(LEFT_SHIFT)  &trans
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none            &bt BT_CLR  &none            &none            &none            &none            &none            &none            &kp KP_NUMLOCK
&none         &none         &none         &none         &none         &out OUT_TOG     &none       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none            &none
&none         &none         &none         &none         &none         &none            &none       &none            &none            &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &none
&none         &none         &none         &none         &none         &rgb_ug RGB_TOG  &none       &none            &none            &none            &none            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &none
&none         &bootloader   &none         &none         &none         &none            &none       &none            &bootloader      &none
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&none   &none  &none             &none      &none              &none    &none         &none           &none           &none            &none           &none            &none  &kp DELETE
&none   &none  &kp C_AC_BACK     &none      &kp C_AC_FORWARD   &none    &msc SCRL_UP  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none           &none
&trans  &none  &mkp RCLK         &mkp MCLK  &mkp LCLK          &none    &none         &none           &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none   &none  &kp LC(LG(LEFT))  &none      &kp LC(LG(RIGHT))  &none    &none         &none           &none           &none            &none           &none            &none  &none       &none  &none
&none   &none  &none             &none      &mo MOUSE_SLOW     &mo MOUSE_FAST  &trans        &none           &none           &none
            >;
        };

        // Active after first &alt_latch; same key position is plain Tab (no extra Alt press).

        alt_tab_layer {
            display-name = "ALT-TAB";
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Held by F21/F22 on Mouse. All &trans so &mmv keys stay on Mouse;
        // speed is applied by &mmv_input_listener scalers below.

        mouse_slow {
            display-name = "Slow";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_fast {
            display-name = "Fast";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

/* While layer 1 (LOWER) is held, the right trackpoint scrolls instead of moving
 * the pointer. The override replaces the listener's base processors for that layer,
 * so trackpoint movement no longer temp-activates the Mouse layer during scroll.
 *
 * ip_mute_if_lctrl drops movement when Left Ctrl is in the HID report, including
 * implicit mods from LC(...) keys (Ctrl+Tab, Ctrl+W, etc.). */

/* F21 (MOUSE_SLOW) = 1/3 &mmv speed; F22 (MOUSE_FAST) = 3x. Scroll keys are unchanged.
 * Slow is listed first so it wins if both thumbs are held. */

&mmv_input_listener {
    slow {
        layers = <MOUSE_SLOW>;
        input-processors = <&ip_xy_scale 1 3>;
    };

    fast {
        layers = <MOUSE_FAST>;
        input-processors = <&ip_xy_scale 3 1>;
    };
};

&trackpoint_listener {
    scroller {
        layers = <LOWER>;
        input-processors =
            <&ip_mute_if_lctrl>,
            <&ip_x_half 1 2>,
            <&ip_y_invert (-1) 1>,
            <&ip_xy_to_scroll>;
    };
};
