#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define LOWER 1
#define ALT_TAB_LAYER 4
#define BOT bootloader

/ {
    input_processors {
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };

        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };

        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };

        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };
    };
};

/ {
    macros {
        // Replaces "&mo 1" on lower-layer hold keys.

        mod_key: mod_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo LOWER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_release>,
                <&mo ALT_TAB_LAYER>,
                <&macro_release>,
                <&mo LOWER>;
        };

        // First tap: press Alt once, send key, enable ALT_TAB_LAYER.
        // Further taps hit that layer (plain &kp) so Alt refcount stays at 1.
        // ZMK refcounts modifiers — macro_press LALT on every tap was the "giga latch".

        alt_latch: alt_latch {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&mo ALT_TAB_LAYER>;
        };
    };
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        sp_sc: behavior_spacescroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC       &kp N1        &kp N2  &kp N3    &kp N4         &kp N5           &kp C_MUTE       &kp C_MUTE  &kp N6          &kp N7        &kp N8  &kp N9    &kp N0     &kp BACKSPACE
&kp TAB       &kp Q         &kp W   &kp E     &kp R          &kp T            &kp Y            &kp U       &kp I           &kp O         &kp P   &kp BSLH
&mo 3         &kp A         &kp S   &kp D     &kp F          &kp G            &mkp LCLK        &mkp LCLK   &kp H           &kp J         &kp K   &kp L     &kp SEMI   &kp ENTER
&kp LSHFT     &kp Z         &kp X   &kp C     &kp V          &kp B            &kp PG_DN        &kp PG_UP   &msc SCRL_DOWN  &msc SCRL_UP  &kp N   &kp M     &kp COMMA  &kp DOT        &kp FSLH  &kp RSHIFT
&kp LEFT_GUI  &kp LEFT_ALT  &none   &mod_key  &kp BACKSPACE  &mt LCTRL SPACE  &mt LCTRL SPACE  &kp MINUS   &kp EQUAL       &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp ESC    &kp F1      &kp F2                  &kp F3          &kp F4                   &kp F5           &bt BT_CLR   &kp C_MUTE  &kp F6         &kp F7      &kp F8    &kp F9     &kp F10   &kp DEL
&kp TAB    &kp ESCAPE  &kp LC(PAGE_UP)         &kp LC(T)       &kp LC(PAGE_DOWN)        &out OUT_TOG     &kp PAGE_UP  &kp HOME    &kp UP         &kp END     &kp HOME  &kp BSLH
&none      &caps_word  &kp LA(LC(LEFT_ARROW))  &alt_latch TAB  &kp LA(LC(RIGHT_ARROW))  &trans           &mkp RCLK    &mkp RCLK   &kp PAGE_DOWN  &kp LEFT    &kp DOWN  &kp RIGHT  &kp SQT   &kp ENTER
&kp LSHFT  &trans      &kp LS(LC(PAGE_UP))     &kp LC(W)       &kp LS(LC(PAGE_DOWN))    &rgb_ug RGB_TOG  &trans       &trans      &bl BL_DEC     &bl BL_INC  &trans    &trans     &kp LBKT  &kp RBKT   &kp UNDER  &kp PLUS
&BOT       &kp LGUI    &kp LALT                &kp SPACE       &trans                   &trans           &trans       &trans      &kp DOT        &BOT
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3     &kp F4  &kp F5           &bt BT_CLR  &kp C_MUTE  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp BSPC
&kp TAB    &trans    &kp UP    &trans     &trans  &out OUT_TOG     &trans      &trans      &trans  &trans  &trans  &trans
&kp CAPS   &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans           &mkp RCLK   &none       &trans  &trans  &trans  &trans  &trans   &trans
&kp LSHFT  &trans    &trans    &trans     &trans  &rgb_ug RGB_TOG  &trans      &trans      &none   &none   &trans  &trans  &trans   &trans    &trans  &trans
&none      &kp LGUI  &kp LALT  &kp SPACE  &mo 1   &mo 1            &trans      &trans      &trans  &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&none   &none  &none      &none      &none      &none  &none         &none           &none           &none            &none  &none  &none  &none
&none   &none  &none      &none      &none      &none  &msc SCRL_UP  &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &none  &none
&trans  &none  &mkp RCLK  &mkp MCLK  &mkp LCLK  &none  &none         &none           &msc SCRL_DOWN  &none            &none  &none  &none  &none
&none   &none  &none      &none      &none      &none  &none         &none           &none           &none            &none  &none  &none  &none  &none  &none
&none   &none  &none      &none      &none      &none  &none         &none           &none           &none
            >;
        };

        // Active after first &alt_latch; same key position is plain Tab (no extra Alt press).

        alt_tab_layer {
            display-name = "ALT-TAB";
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
